          <input name="name" placeholder="Driver name" required />
          <input name="phone" placeholder="Phone" />
          <input name="email" placeholder="Email" />
          <input name="base" placeholder="Base / depot" />
          <textarea name="notes" rows="2" placeholder="Notes"></textarea>
          <button class="secondary" type="submit">Add driver</button>
        </form>
        <div id="driverList" class="database-list"></div>
      </article>
    </div>
  </section>

  <section class="admin-shell view-panel" data-panel="reports">
    <section class="workspace-hero reports-hero">
      
      <div class="hero-brand">
        <div class="hero-logo-wrap">
          <img class="hero-brand-logo" data-hero-brand-logo alt="Company logo" hidden />
          <div class="hero-brand-initials" data-hero-brand-initials>P2P</div>
        </div>
        <div class="hero-brand-copy">
          <span data-hero-brand-company>Point 2 Point Operations</span>
          <strong data-hero-brand-title>Coach Safe Route Planner</strong>
        </div>
      </div>
      <div class="hero-admin">
        <div>
          <span data-company-plan>Starter · Trial</span><small>Signed in as</small>
          <strong data-hero-current-user>Point 2 Point Admin</strong>
        </div>
        <button class="secondary small-button hero-logout-button" data-hero-logout type="button">Logout</button>
      </div>

      <div class="workspace-banner-copy">
      <div>
        <p class="eyebrow">Road intelligence</p>
        <h2>Route reports and unsuitable-road records.</h2>
        <p>Review driver and operator concerns before they affect another journey.</p>
      </div>
      </div>
    </section>
    <section class="platform-status-strip" aria-label="Platform status">
      <div data-status="routing"><span class="status-dot"></span><strong>Routing</strong><small>Checking</small></div>
      <div data-status="database"><span class="status-dot"></span><strong>Database</strong><small>Checking</small></div>
      <div data-status="pins"><span class="status-dot ready"></span><strong>Verified pins</strong><small>Ready</small></div>
      <div data-status="driver"><span class="status-dot ready"></span><strong>Driver V3</strong><small>Ready</small></div>
    </section>

    <div class="single-workspace-grid">
      

      <section class="module-kpi-strip" id="reportKpis">
      <div><span>Total reports</span><strong>0</strong></div>
      <div><span>New today</span><strong>0</strong></div>
      <div><span>Route-linked</span><strong>0</strong></div>
      <div><span>Needs review</span><strong>0</strong></div>
    </section>
      <article id="reportsCard" class="panel admin-card feature-card reports-feature-card">
        <div id="reportList" class="database-list empty">No road reports yet.</div>
      </article>
    </div>
  </section>

  <section class="admin-shell view-panel" data-panel="settings">
    <section class="workspace-hero settings-hero">
      
      <div class="hero-brand">
        <div class="hero-logo-wrap">
          <img class="hero-brand-logo" data-hero-brand-logo alt="Company logo" hidden />
          <div class="hero-brand-initials" data-hero-brand-initials>P2P</div>
        </div>
        <div class="hero-brand-copy">
          <span data-hero-brand-company>Point 2 Point Operations</span>
          <strong data-hero-brand-title>Coach Safe Route Planner</strong>
        </div>
      </div>
      <div class="hero-admin">
        <div>
          <span data-company-plan>Starter · Trial</span><small>Signed in as</small>
          <strong data-hero-current-user>Point 2 Point Admin</strong>
        </div>
        <button class="secondary small-button hero-logout-button" data-hero-logout type="button">Logout</button>
      </div>

      <div class="workspace-banner-copy">
      <div>
        <p class="eyebrow">Company workspace</p>
        <h2>Company, branding, users and subscription.</h2>
        <p>Configure the customer organisation and control who can use the platform.</p>
      </div>
      </div>
    </section>
    <section class="platform-status-strip" aria-label="Platform status">
      <div data-status="routing"><span class="status-dot"></span><strong>Routing</strong><small>Checking</small></div>
      <div data-status="database"><span class="status-dot"></span><strong>Database</strong><small>Checking</small></div>
      <div data-status="pins"><span class="status-dot ready"></span><strong>Verified pins</strong><small>Ready</small></div>
      <div data-status="driver"><span class="status-dot ready"></span><strong>Driver V3</strong><small>Ready</small></div>
    </section>

    <div class="single-workspace-grid">
      


      <section id="onboardingProgressCard" class="panel onboarding-progress-card">
        <div>
          <p class="eyebrow">Company onboarding</p>
          <h3 id="onboardingProgressTitle">Complete your company setup</h3>
          <p id="onboardingProgressText" class="muted">Loading company status…</p>
        </div>
        <button id="openOnboardingBtn" class="primary" type="button">Continue setup</button>
      </section>

      <nav class="company-tabs" aria-label="Company workspace">
        <button class="active" type="button" data-company-tab="profile">Profile</button>
        <button type="button" data-company-tab="branding">Branding</button>
        <button type="button" data-company-tab="users">Users & roles</button>
        <button type="button" data-company-tab="subscription">Subscription</button>
        <button type="button" data-company-tab="audit">Audit log</button>
        <button type="button" data-company-tab="system-health">System health</button>
      </nav>

      <article class="panel company-tab-panel active" data-company-panel="profile">
        <p class="eyebrow">Company profile</p><h3>Organisation details</h3>
        <form id="companyProfileForm" class="commercial-form">
          <label>Trading name<input id="commercialCompanyName" required></label>
          <label>Legal name<input id="commercialLegalName"></label>
          <label>Workspace slug<input id="commercialCompanySlug" disabled></label>
          <label>Country<select id="commercialCountry"><option value="GB">United Kingdom</option><option value="IE">Ireland</option><option value="GH">Ghana</option></select></label>
          <label>Timezone<input id="commercialTimezone" value="Europe/London"></label>
          <label>Support phone<input id="commercialSupportPhone"></label>
          <label>Support email<input id="commercialSupportEmail" type="email"></label>
          <label>Depot address<textarea id="commercialDepotAddress" rows="3"></textarea></label>
          <button class="primary" type="submit">Save company profile</button>
        </form>
      </article>

      <article class="panel company-tab-panel" data-company-panel="branding">
        <p class="eyebrow">White-label branding</p><h3>Customer-facing appearance</h3>
        <form id="commercialBrandingForm" class="commercial-form">
          <label>Brand name<input id="commercialBrandName"></label>
          <label>Primary colour<input id="commercialPrimaryColor" type="color" value="#edc553"></label>
          <label>Secondary colour<input id="commercialSecondaryColor" type="color" value="#101821"></label>
          <label>Driver app title<input id="commercialDriverTitle" value="Driver Navigation"></label>
          <label>PDF footer<input id="commercialPdfFooter" value="Powered by Coach Safe"></label>
          <label class="wide-field">Logo URL or data URL<textarea id="commercialLogoUrl" rows="4"></textarea></label>
          <label class="switch-field"><input id="commercialPoweredBy" type="checkbox" checked> Show “Powered by Coach Safe”</label>
          <button class="primary" type="submit">Apply branding</button>
        </form>
      </article>

      <article class="panel company-tab-panel" data-company-panel="users">
        <div class="card-head"><div><p class="eyebrow">Access control</p><h3>Company users</h3></div><button id="toggleNewUser" class="primary" type="button">Add user</button></div>
        <form id="newCompanyUserForm" class="commercial-form" hidden>
          <label>Name<input id="newCompanyUserName" required></label>
          <label>Email<input id="newCompanyUserEmail" type="email" required></label>
          <label>Temporary password<input id="newCompanyUserPassword" type="password" minlength="10" required></label>
          <label>Role<select id="newCompanyUserRole"><option value="OWNER">Owner</option><option value="ADMIN">Admin</option><option value="OPERATIONS_MANAGER">Operations Manager</option><option value="DISPATCHER" selected>Dispatcher</option><option value="FLEET_MANAGER">Fleet Manager</option><option value="DRIVER">Driver</option><option value="READ_ONLY">Read Only</option></select></label>
          <button class="primary" type="submit">Create user</button>
        </form>
        <div id="companyUserList" class="commercial-list"></div>
      </article>

      <article class="panel company-tab-panel" data-company-panel="subscription">
        <p class="eyebrow">Subscription</p><h3>Commercial plan</h3>
        <div id="commercialSubscriptionSummary" class="subscription-summary"></div>
        <div class="plan-grid">
          <article><strong>Starter</strong><span>Small operators</span><small>Planning, fleet, drivers and navigation.</small></article>
          <article class="recommended"><strong>Professional</strong><span>Growing fleets</span><small>Tracking, dispatch, reports and white label.</small></article>
          <article><strong>Enterprise</strong><span>Large operators</span><small>API, SSO, custom domains and enterprise support.</small></article>
        </div>
      </article>

      <article class="panel company-tab-panel" data-company-panel="audit">
        <p class="eyebrow">Audit log</p><h3>Recent account activity</h3>
        <div id="commercialAuditList" class="commercial-list"></div>
      </article>

      <article id="systemHealthPanel" class="panel company-tab-panel system-health-panel" data-company-panel="system-health">
        <div class="system-health-head">
          <div>
            <p class="eyebrow">Support & diagnostics</p>
            <h3>System Health</h3>
            <p class="muted">Run read-only checks across authentication, company context, APIs, PostgreSQL and operational datasets.</p>
          </div>
          <div class="system-health-actions">
            <button id="runDiagnosticsBtn" class="primary" type="button">Run diagnostics</button>
            <button id="downloadDiagnosticsBtn" class="secondary" type="button" disabled>Download report</button>
          </div>
        </div>

        <section class="diagnostic-overall">
          <div id="diagnosticOverallIcon" class="diagnostic-overall-icon pending">…</div>
          <div>
            <span>Overall status</span>
            <strong id="diagnosticOverallStatus">Not checked</strong>
            <small id="diagnosticCheckedAt">Run diagnostics to begin.</small>
          </div>
        </section>

        <div id="diagnosticSummaryGrid" class="diagnostic-summary-grid">
          <article><span>Database</span><strong>Not checked</strong><small>PostgreSQL</small></article>
          <article><span>API</span><strong>Not checked</strong><small>Application endpoints</small></article>
          <article><span>Company</span><strong>Not checked</strong><small>Tenant context</small></article>
          <article><span>Operational data</span><strong>Not checked</strong><small>Routes, fleet and drivers</small></article>
        </div>

        <section class="diagnostic-section">
          <div class="diagnostic-section-title"><div><p class="eyebrow">Identity</p><h4>Current user and company</h4></div></div>
          <div id="diagnosticIdentity" class="diagnostic-kv-grid"><p class="muted">No diagnostic result yet.</p></div>
        </section>

        <section class="diagnostic-section">
          <div class="diagnostic-section-title"><div><p class="eyebrow">Data visibility</p><h4>Company-scoped records</h4></div></div>
          <div id="diagnosticDataCounts" class="diagnostic-count-grid"></div>
          <div id="diagnosticTenantWarning" class="diagnostic-warning" hidden></div>
        </section>

        <section class="diagnostic-section">
          <div class="diagnostic-section-title"><div><p class="eyebrow">Endpoint tests</p><h4>API checks</h4></div><span id="diagnosticApiLatency">—</span></div>
          <div id="diagnosticApiTests" class="diagnostic-test-list"></div>
        </section>

        <section class="diagnostic-section">
          <div class="diagnostic-section-title"><div><p class="eyebrow">Infrastructure</p><h4>Runtime and database</h4></div></div>
          <div id="diagnosticInfrastructure" class="diagnostic-kv-grid"></div>
        </section>

        <section id="diagnosticCompanyDistributionSection" class="diagnostic-section" hidden>
          <div class="diagnostic-section-title"><div><p class="eyebrow">Support-only</p><h4>Company record distribution</h4></div></div>
          <p class="muted">Visible only when protected global diagnostics are enabled on the server.</p>
          <div id="diagnosticCompanyDistribution" class="diagnostic-table-wrap"></div>
        </section>

        <section id="diagnosticErrorSection" class="diagnostic-section" hidden>
          <div class="diagnostic-section-title"><div><p class="eyebrow">Technical detail</p><h4>Exact diagnostic failure</h4></div></div>
          <div id="diagnosticErrorDetail" class="diagnostic-error-detail"></div>
        </section>

        <section class="diagnostic-section">
          <div class="diagnostic-section-title"><div><p class="eyebrow">Suggested action</p><h4>Diagnostic findings</h4></div></div>
          <div id="diagnosticFindings" class="diagnostic-findings"><p class="muted">No findings yet.</p></div>
        </section>
      </article>

      <article id="settingsCard" class="panel admin-card wide-card">
        <h3>Company branding</h3>
        <p class="muted">Upload a logo and rename the platform for print reports, driver links and the operator dashboard.</p>
        <form id="settingsForm" class="mini-form settings-form">
          <input name="companyName" id="companyNameInput" placeholder="Company name" />
          <input name="appName" id="appNameInput" placeholder="App name" />
          <input name="accentName" id="accentNameInput" placeholder="Theme label e.g. Gold / Black" />
          <label class="file-label">Company logo
            <input id="logoUpload" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
          </label>
          <div class="logo-preview-box"><img id="logoPreview" alt="Logo preview" hidden /><span id="logoPreviewText">No logo uploaded</span></div>
          <div class="card-actions">
            <button class="secondary" type="submit">Save branding</button>
            <button id="clearLogo" class="secondary danger" type="button">Remove logo</button>
          </div>
        </form>

        <section class="operator-preferences">
          <div class="settings-section-head">
            <div>
              <p class="eyebrow">Operator preferences</p>
              <h3>Daily workflow defaults</h3>
              <p class="muted">These preferences are stored securely in this browser and do not change server routing rules until a route is calculated.</p>
            </div>
          </div>

          <form id="operatorPreferencesForm" class="mini-form settings-form">
            <label>Default landing workspace
              <select id="defaultLandingView">
                <option value="planner">Route planner</option>
                <option value="dashboard">Operations dashboard</option>
              </select>
            </label>

            <fieldset class="checks preference-checks">
              <legend>Default route preferences</legend>
              <label><input id="prefAvoidTolls" type="checkbox" /> Avoid toll roads</label>
              <label><input id="prefAvoidFerries" type="checkbox" /> Avoid ferries</label>
              <label><input id="prefAvoidUnpaved" type="checkbox" /> Avoid unpaved roads</label>
              <label><input id="prefAvoidTunnels" type="checkbox" /> Avoid tunnels</label>
              <label><input id="prefAvoidLez" type="checkbox" /> Avoid low-emission zones where possible</label>
            </fieldset>

            <label class="compact-preference">
              <input id="compactDashboard" type="checkbox" />
              Use compact cards on smaller laptops
            </label>

            <button class="secondary" type="submit">Save operator preferences</button>
          </form>
        </section>
      </article>
    </div>
  </section>

  <footer class="footer">
    <strong>Important:</strong> This MVP supports safer route planning but does not replace road signs, temporary restrictions, driver judgement, legal compliance or operator route approval.
  </footer>
