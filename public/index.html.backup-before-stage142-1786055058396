    <div class="single-workspace-grid">
      

      <section class="module-kpi-strip" id="driverKpis">
      <div><span>Total drivers</span><strong>0</strong></div>
      <div><span>Assigned</span><strong>0</strong></div>
      <div><span>Available</span><strong>0</strong></div>
      <div><span>Contact ready</span><strong>0</strong></div>
    </section>
      <article id="driverCard" class="panel admin-card feature-card driver-feature-card">
