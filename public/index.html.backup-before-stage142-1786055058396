        <small class="field-help">Existing single-company accounts may leave this blank.</small>
      </label>
      <label>
        Email
        <input id="loginEmail" type="email" value="admin@point2point.site" placeholder="admin@point2point.site" autocomplete="username" />
      </label>
      <label>
        Password
        <input id="loginPassword" type="password" placeholder="Enter password" autocomplete="current-password" />
      </label>
      <button id="loginButton" class="primary" type="button">Sign in</button>
      <p id="loginMessage" class="login-message">Default beta admin: <strong>admin@point2point.site</strong>. Set <strong>ADMIN_PASSWORD</strong> in Render.</p>
    </div>
  </div>

  <div id="appShell" class="app-shell" aria-hidden="true">
  <header class="topbar legacy-topbar">
    <div class="brand-block">
      <img id="brandLogo" class="brand-logo" alt="Company logo" hidden />
      <div id="brandInitials" class="logo-mark">P2P</div>
      <div>
        <p class="eyebrow" id="brandCompany">Point 2 Point Operations MVP</p>
        <h1 id="brandTitle">Coach Safe Route Planner</h1>
        <p class="subtitle">Plan, approve, assign and share coach-safe routes with vehicle profiles, driver links, route status and issue reporting.</p>
