  <dialog id="companyOnboardingDialog" class="onboarding-dialog">
    <div class="onboarding-shell">
      <div class="onboarding-head"><div><p class="eyebrow">Welcome to Coach Safe</p><h2>Set up the company workspace</h2></div><button id="closeOnboardingBtn" class="ghost" type="button">Close</button></div>
      <div class="onboarding-steps"><button class="active" data-onboard-step="1">1 Company</button><button data-onboard-step="2">2 Branding</button><button data-onboard-step="3">3 Operations</button><button data-onboard-step="4">4 Launch</button></div>
      <section class="onboard-panel active" data-onboard-panel="1"><label>Company name<input id="onboardCompanyName"></label><label>Legal name<input id="onboardLegalName"></label><label>Country<select id="onboardCountry"><option value="GB">United Kingdom</option><option value="IE">Ireland</option><option value="GH">Ghana</option></select></label></section>
      <section class="onboard-panel" data-onboard-panel="2"><label>Brand name<input id="onboardBrandName"></label><label>Primary colour<input id="onboardPrimaryColour" type="color" value="#edc553"></label><label>Logo URL/data URL<textarea id="onboardLogoUrl" rows="4"></textarea></label></section>
      <section class="onboard-panel" data-onboard-panel="3"><label><input id="onboardPins" type="checkbox" checked> Require verified pins</label><label><input id="onboardFerries" type="checkbox" checked> Avoid ferries by default</label><label><input id="onboardUnpaved" type="checkbox" checked> Avoid unpaved roads by default</label></section>
      <section class="onboard-panel" data-onboard-panel="4"><div class="launch-checklist"><span>Company configured</span><span>Branding applied</span><span>Operational defaults saved</span><span>Ready to launch</span></div></section>
      <div class="onboarding-actions"><button id="onboardBack" class="secondary" type="button">Back</button><button id="onboardNext" class="primary" type="button">Next</button><button id="onboardFinish" class="primary" type="button" hidden>Launch workspace</button></div>
    </div>
  </dialog>

