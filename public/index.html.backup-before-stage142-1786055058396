    </section>
    <section class="platform-status-strip" aria-label="Platform status">
      <div data-status="routing"><span class="status-dot"></span><strong>Routing</strong><small>Checking</small></div>
      <div data-status="database"><span class="status-dot"></span><strong>Database</strong><small>Checking</small></div>
      <div data-status="pins"><span class="status-dot ready"></span><strong>Verified pins</strong><small>Ready</small></div>
      <div data-status="driver"><span class="status-dot ready"></span><strong>Driver V3</strong><small>Ready</small></div>
    </section>

    <section class="panel planner-panel">
      <div class="section-title">
        <span>01</span>
        <div>
          <h2>Route details</h2>
          <p>Select a saved coach, assign a driver and calculate the route.</p>
        </div>
      </div>

      
        <ol class="planner-workflow" aria-label="Route planning workflow">
          <li><span>1</span><strong>Start</strong><small>Search and verify</small></li>
          <li><span>2</span><strong>Destination</strong><small>Confirm exact pin</small></li>
          <li><span>3</span><strong>Stops</strong><small>Add in travel order</small></li>
          <li><span>4</span><strong>Coach</strong><small>Apply dimensions</small></li>
          <li><span>5</span><strong>Driver</strong><small>Select assignment</small></li>
          <li><span>6</span><strong>Calculate</strong><small>Review restrictions</small></li>
          <li><span>7</span><strong>Approve</strong><small>Save and share</small></li>
        </ol>

      <form id="routeForm" class="form-grid">
        <label>
          Start point
          <input name="start" value="Hounslow, London" autocomplete="off" required />
        </label>
        <label>
          Destination
          <input name="destination" value="Wembley Stadium, London" autocomplete="off" required />
        </label>

        <label>
          Saved vehicle database
          <select name="vehicleDatabaseId" id="vehicleSelect">
            <option value="">Use manual coach profile</option>
          </select>
        </label>

        <label>
          Assign driver
          <select name="driverId" id="driverSelect">
            <option value="">No driver assigned</option>
          </select>
        </label>

        <label>
          Coach type
          <select name="preset" id="presetSelect">
            <option value="midi">Midi Coach / 33 seat</option>
            <option value="standard" selected>Standard Coach / 49ÔÇô57 seat</option>
            <option value="triAxle">Tri-axle Coach</option>
            <option value="doubleDecker">Double-decker Coach</option>
          </select>
        </label>

        <div class="dimensions">
          <label>Height m<input name="heightM" type="number" step="0.01" value="3.65" required /></label>
          <label>Width m<input name="widthM" type="number" step="0.01" value="2.55" required /></label>
          <label>Length m<input name="lengthM" type="number" step="0.01" value="12.2" required /></label>
          <label>Weight kg<input name="weightKg" type="number" step="1" value="18000" required /></label>
        </div>

        <fieldset class="checks">
          <legend>Route preferences</legend>
          <label><input type="checkbox" name="avoidLowEmissionZones" /> Avoid low-emission zones where possible</label>
          <label><input type="checkbox" name="avoidTolls" /> Avoid toll roads</label>
          <label><input type="checkbox" name="avoidFerries" checked /> Avoid ferries</label>
          <label><input type="checkbox" name="avoidUnpaved" checked /> Avoid unpaved roads</label>
          <label><input type="checkbox" name="avoidTunnels" /> Avoid tunnels</label>
        </fieldset>

        <button class="primary" type="submit">Calculate coach-safe route</button>
      </form>
    </section>

    <section class="map-shell">
      <div id="map"></div>
      <div class="summary-bar" id="summaryBar">
        <strong>No route calculated yet</strong>
        <span>Use the planner to generate the first route.</span>
      </div>
    </section>

    <section class="panel results-panel">
      <div class="section-title">
        <span>02</span>
        <div>
          <h2>Safety review</h2>
          <p>Warnings, risk score and approval actions.</p>
        </div>
      </div>

      <div id="riskCard" class="risk-card empty">No risk score yet.</div>
      <div id="warnings" class="warnings empty">No warnings yet.</div>

      <label class="full-label">
        Operator approval notes
        <textarea id="operatorNotes" rows="3" placeholder="Example: Final hotel approach checked. Driver must avoid side street after 18:00."></textarea>
      </label>

      <div class="actions">
        <button id="saveRoute" class="secondary" type="button" disabled>Save approved route</button>
        <button id="printRoute" class="secondary" type="button" disabled>Print route pack</button>
        <button id="exportInteractive" class="secondary" type="button" disabled>Export zoomable map</button>
        <button id="openPdfReport" class="secondary" type="button" disabled>Open PDF route report</button>
      </div>

      <details id="reportDetails" class="report-details">
        <summary>Report unsuitable road</summary>
        <form id="reportForm" class="mini-form">
          <label>Road / location name<input name="roadName" placeholder="Example: Narrow hotel approach road" /></label>
          <label>Issue type
            <select name="issueType">
              <option>Unsuitable road</option>
              <option>Low bridge concern</option>
              <option>Narrow road</option>
              <option>Weight restriction concern</option>
              <option>Tight turn</option>
              <option>Coach access restriction</option>
              <option>Other</option>
            </select>
          </label>
          <label>Notes<textarea name="notes" rows="3" placeholder="Describe what the driver/operator found."></textarea></label>
          <button class="secondary" type="submit" disabled id="submitReport">Save road report</button>
        </form>
      </details>

      <h3>Guidance preview</h3>
      <ol id="instructions" class="instructions"></ol>
    </section>
  </main>

  

  
